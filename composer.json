{
    "name": "vinny/customtitlelength",
    "type": "phpbb-extension",
    "description": "Allows board administrators to easily adjust the maximum character limit for topic titles directly from the ACP, removing the default 120-character restriction",
    "homepage": "https://github.com/vinny/phpbb-customtitlelength",
    "version": "1.0.0",
    "keywords": [
        "phpbb",
        "extension",
        "topic",
        "title",
        "subject",
        "length"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Vinny",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "composer/installers": "~1.0"
    },
    "extra": {
        "display-name": "Custom Topic Title Length",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        }
    }
}
